	$(MAKE) $(MAKESILENT) -f CMakeFiles\test_pitch_detector.dir\build.make CMakeFiles/test_pitch_detector.dir/tests/test_pitch_detector.cpp.obj
.PHONY : tests/test_pitch_detector.cpp.obj

tests/test_pitch_detector.i: tests/test_pitch_detector.cpp.i
.PHONY : tests/test_pitch_detector.i

# target to preprocess a source file
tests/test_pitch_detector.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles\test_pitch_detector.dir\build.make CMakeFiles/test_pitch_detector.dir/tests/test_pitch_detector.cpp.i
.PHONY : tests/test_pitch_detector.cpp.i

tests/test_pitch_detector.s: tests/test_pitch_detector.cpp.s
.PHONY : tests/test_pitch_detector.s

# target to generate assembly for a file
tests/test_pitch_detector.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles\test_pitch_detector.dir\build.make CMakeFiles/test_pitch_detector.dir/tests/test_pitch_detector.cpp.s
.PHONY : tests/test_pitch_detector.cpp.s

